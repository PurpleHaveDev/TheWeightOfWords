default Rede1_Publikum4_1 = "Buhrufe von hinten, während vorne bereits begeistert geklatscht wird."
default Rede1_Publikum4_2 = "Konzentrierte Stille im Saal, danach kurzer, prägnanter Applaus."
default Rede1_Publikum4_3 = "Man hört zustimmendes Gemurmel, gefolgt von ruhigem Beifall."
