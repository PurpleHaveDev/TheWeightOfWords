default Rede1_Frage1 = "{size=*1}Wie wollen Sie die Rede einleiten?"
default Rede1_Frage2 = "{size=*1}Wie schildern Sie die Reaktion?"
default Rede1_Frage3 = "{size=*1}Wie wollen Sie zu Weiterem hinführen?"
default Rede1_Frage4 = "{size=*1}Welches Problem stellt sich Ihrer Meinung nach dar?"
